<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\AI\castle_defense_bot.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\AI\castle_defense_bot.onnx.data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\master_gadgets.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\master_roster.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Loadout best-response table used by CounterPicker to choose the singleplayer
         bot's team and gadgets. Regenerate with:
           CastleDefense.BotArena.exe counter-matrix   (sweep)
           python CastleDefense.BotArena/counter/analyze.py (fit, then write the table) -->
    <None Update="Data\counter_table.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Fitted human policy table played by HumanCloneBot. Regenerate via the
         CastleDefense.Simulation "export-policy-table" mode after new games are recorded. -->
    <None Update="Data\human_policy_table.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
